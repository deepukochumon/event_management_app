{
  "name": "event-management-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && python manage.py runserver 0.0.0.0:8000",
    "build": "vite build",
    "preview": "vite preview",
    "backend:install": "cd backend && pip install -r requirements.txt",
    "backend:migrate": "cd backend && python manage.py migrate",
    "backend:makemigrations": "cd backend && python manage.py makemigrations",
    "backend:seed": "cd backend && python manage.py seed_demo_data",
    "backend:test": "cd backend && python manage.py test",
    "lint": "eslint . --ext js,jsx --max-warnings 0"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chart.js": "^4.4.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@tanstack/react-query": "^5.59.0",
    "@mui/material": "^6.1.8",
    "lucide-react": "^0.460.0",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "vite": "^5.4.6"
  }
}
